# ── Grudge Studio Game — Environment Variables ────────────────
# Copy to .env.local for local development.
# On Vercel, set in Project Settings > Environment Variables.

# Auth gateway (browser redirects only)
VITE_AUTH_URL=https://id.grudge-studio.com

# Game API — same-origin /api in production (Vercel rewrites → Railway).
# Local without proxy: full Railway URL with /api suffix.
VITE_API_URL=/api
# VITE_API_URL=https://grudge-api-production-0d46.up.railway.app/api
VITE_RAILWAY_API_URL=https://grudge-api-production-0d46.up.railway.app

# Asset CDN (R2 / Cloudflare)
VITE_USE_CDN=false
VITE_ASSET_CDN_URL=https://assets.grudge-studio.com

# ObjectStore game data JSON
VITE_OBJECTSTORE_URL=https://objectstore.grudge-studio.com

# Optional WebSocket
VITE_WS_URL=wss://ws.grudge-studio.com
